# PostgreSQL connection supplied by Chabokan
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate two different values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
LICENSE_SECRET=replace-with-another-random-value-of-at-least-32-characters

COOKIE_SECURE=true
CROSS_SITE_COOKIES=false
FRAME_ANCESTORS='self'

# Optional runtime tuning
DB_POOL_RECYCLE=300
PORT=5000
